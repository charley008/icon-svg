# Desktop: bin/icon-svg.exe reads .env from its parent directory.
# Default data: parent-of-bin/data; go run ./cmd/icon-svg uses working-directory/data.
# Optional DATA_DIR overrides the default; prefer an absolute path.
LISTEN_ADDR=127.0.0.1:8000
OPEN_BROWSER=true
# Used only when creating the first administrator. Empty generates a password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set the external origin behind a reverse proxy, e.g. https://icons.example.com.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
# Optional: override directories beside the program.
LIBRARY_DIR=
WEB_DIR=

# Library scan interval; 0 disables periodic scans.
SCAN_INTERVAL=60m
